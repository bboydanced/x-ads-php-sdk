{
  "name": "hborras/twitter-php-ads-sdk",
  "type": "library",
  "description": "PHP SDK for the X (formerly Twitter) Ads API v12",
  "keywords": [
    "ads",
    "ads api",
    "api",
    "oauth",
    "rest",
    "social",
    "twitter",
    "twitter api",
    "twitter oauth",
    "x",
    "x ads"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Hector Borras",
      "email": "hborrasaleixandre@gmail.com",
      "role": "Developer"
    }
  ],
  "support": {
    "source": "https://github.com/bboydanced/x-ads-php-sdk",
    "issues": "https://github.com/bboydanced/x-ads-php-sdk/issues"
  },
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Hborras\\TwitterAdsSDK\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Hborras\\TwitterAdsSDK\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit --testsuite Unit",
    "test:integration": "phpunit --testsuite Integration"
  }
}
